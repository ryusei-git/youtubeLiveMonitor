<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <statusListener class="ch.qos.logback.core.status.NopStatusListener" />

    <include resource="org/springframework/boot/logging/logback/defaults.xml" />

    <!--
        標準出力。bin/service.sh がこれを logs/service.log にリダイレクトしており、
        管理者が「サービス全体で何が起きているか」を見る唯一の入口になる。

        レベルを出力に含めること。以前は "%d - %msg" だけで WARN も DEBUG も
        見分けが付かず、grep ERROR / grep WARN で何も引っかからなかった（実際に
        チャンネル登録ミスによる 404 の警告を見落とした）。

        しきい値を INFO にしているのは、DEBUG まで流すと 14 チャンネル分の
        正常時のログで埋まり、肝心の警告が埋もれるため。チャンネル単位の詳細は
        CHANNEL_LOG 側に DEBUG まで残るので情報は失われない。

        相関 ID（RequestContext が MDC の requestId に載せる。画面・API のリクエストの処理中だけある）は、
        本文の先頭に "[相関ID] " として出す。監査ログ（audit_logs.request_id）で見つけた ID でこのログを
        引けるようにするため（出していなかった間は、監査ログの相関 ID が何の役にも立たなかった）。
        ・レベルとロガーの間ではなく本文の先頭に置くのは、ChannelLogReader.LOG_LINE_PATTERN を変えずに
          済ませるため。パターンは「日時 [レベル] ロガー - 本文」の並びだけを見て本文の中身を問わないので、
          14 日分残る古い書式の行も新しい行も同じように読め、ログ画面の「内容」にも ID がそのまま出る。
        ・%X{requestId} に既定値を付けて全行に印を出す書き方にせず、%replace で「ID があるときだけ付ける」のは、
          巡回など大半の行はリクエストの外で ID を持たず、全行に空の印が並ぶとチャンネル別ログが読みにくくなるため。
        3 つの appender（CONSOLE・CHANNEL_LOG・SERVICE_FILE）の pattern は同じ文字列にすること。
    -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>
        </filter>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%level] %logger{36} - %replace(%X{requestId}){'^(.+)$', '[$1] '}%msg%n</pattern>
        </encoder>
    </appender>

    <!--
        MDC の channelId をキーに、チャンネルごとに別ファイルへログを振り分ける。
        LiveBroadcastListener が監視サイクル中に MDC.put("channelId", ...) するので、
        そのチャンネルを処理している間に発生した全ログ（LiveStatusChecker, YouTubeMonitorService,
        NotificationService 経由のものも含む）が対象チャンネルのファイルに書き込まれる。
        MDC が未設定（システムログ）の場合は default.log に集約される。

        totalSizeCap は SiftingAppender の内側なので「チャンネルごと」に掛かり、全体の上限ではない
        （20 チャンネルなら最大 2GB）。1 チャンネルが暴走して他を圧迫するのを抑えるためのもの
        （導入時点の全体量は 194MB）。cleanHistoryOnStart は、日付が変わる瞬間に動いていなかった
        期間の古いファイルが maxHistory の掃除から漏れるのを防ぐため。
    -->
    <appender name="CHANNEL_LOG" class="ch.qos.logback.classic.sift.SiftingAppender">
        <discriminator>
            <key>channelId</key>
            <defaultValue>system</defaultValue>
        </discriminator>
        <sift>
            <appender name="CHANNEL_LOG-${channelId}" class="ch.qos.logback.core.rolling.RollingFileAppender">
                <file>logs/channels/${channelId}.log</file>
                <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
                    <fileNamePattern>logs/channels/${channelId}.%d{yyyy-MM-dd}.log</fileNamePattern>
                    <maxHistory>14</maxHistory>
                    <totalSizeCap>100MB</totalSizeCap>
                    <cleanHistoryOnStart>true</cleanHistoryOnStart>
                </rollingPolicy>
                <encoder>
                    <pattern>%d{yyyy-MM-dd HH:mm:ss} [%level] %logger{36} - %replace(%X{requestId}){'^(.+)$', '[$1] '}%msg%n</pattern>
                </encoder>
            </appender>
        </sift>
    </appender>

    <!-- CLI コマンド実行時はフレームワークの起動ログ・アプリ自身のログを抑え、コマンドの出力だけが見えるようにする -->
    <springProfile name="cli">
        <property name="ROOT_LOG_LEVEL" value="WARN" />
        <property name="APP_LOG_LEVEL" value="WARN" />
    </springProfile>
    <springProfile name="!cli">
        <property name="ROOT_LOG_LEVEL" value="INFO" />
        <property name="APP_LOG_LEVEL" value="DEBUG" />
    </springProfile>

    <logger name="com.example.monitor" level="${APP_LOG_LEVEL}" additivity="true">
        <appender-ref ref="CHANNEL_LOG" />
    </logger>

    <root level="${ROOT_LOG_LEVEL}">
        <appender-ref ref="CONSOLE" />
    </root>

    <!--
        root（Spring・Hibernate・Tomcat を含む全体）のログを日ごとに回して残す。
        CONSOLE の出力先 logs/service.log は起動時に数世代回すだけなので、1 日に何度も再起動すると
        前夜の記録が消え、長く動かすと 1 ファイルが際限なく伸びる。こちらは日付で区切り、期間と総量で消す。

        CONSOLE と同じく INFO のしきい値を付ける。com.example.monitor のロガーは DEBUG かつ
        additivity="true" なので、root の appender には全チャンネルの DEBUG が流れ込む
        （root のレベルは子のロガーから来たイベントを絞らない）。チャンネル単位の DEBUG は CHANNEL_LOG にある。
        書式は ChannelLogReader のパーサーと対なので CHANNEL_LOG と揃える。

        CLI の実行はファイルに残さない（常駐サービスのログに混ざらないように）。<root> の中に
        <springProfile> を入れ子にする書き方は Spring Boot が受け付けない（起動時に警告して無視する）ため、
        2 つ目の <root> で appender を足している（<root> は何度書いても同じ root ロガーを指し、appender は追加になる）。
        appender の定義ごとこの中に置くのは、定義しただけで空の logs/service-app.log が CLI の作業ディレクトリに作られるため。
    -->
    <springProfile name="!cli">
        <appender name="SERVICE_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
                <level>INFO</level>
            </filter>
            <file>logs/service-app.log</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
                <fileNamePattern>logs/service-app.%d{yyyy-MM-dd}.log</fileNamePattern>
                <maxHistory>14</maxHistory>
                <totalSizeCap>500MB</totalSizeCap>
                <cleanHistoryOnStart>true</cleanHistoryOnStart>
            </rollingPolicy>
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss} [%level] %logger{36} - %replace(%X{requestId}){'^(.+)$', '[$1] '}%msg%n</pattern>
            </encoder>
        </appender>
        <root>
            <appender-ref ref="SERVICE_FILE" />
        </root>
    </springProfile>
</configuration>
