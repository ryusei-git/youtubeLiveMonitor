# YouTube API Configuration
# Google Cloud Console から取得してください
# https://console.cloud.google.com/
YOUTUBE_API_KEY=your_youtube_api_key_here

# YouTube の検索（search.list）の 1 日の回数の上限（米国太平洋時間の 0 時＝日本の 16〜17 時に戻る）
# 既定値は、検索が 1 回 100 単位の旧方式でも 1 日 10,000 単位に収まる値
# （52 回 × 100 = 5,200 単位。動画の収集の 3,000 単位と合わせて 8,200 単位）。
# Cloud Console で検索が 1 回 1 単位の新方式と確かめられたら、増やしてよい。
# その場の検索の上限は DAILY_LIMIT - DISCOVERY_LIMIT（定期の新人発掘の枠を食わない）。
YOUTUBE_SEARCH_DAILY_LIMIT=52
YOUTUBE_SEARCH_DISCOVERY_LIMIT=12
YOUTUBE_SEARCH_PER_USER_LIMIT=10

# Discord Webhook Configuration
# Discord サーバー設定から Webhook URL を取得してください
DISCORD_WEBHOOK_URL=https://discordapp.com/api/webhooks/your_webhook_id_here

# Initial Admin Account
# 起動時に管理者（app_users テーブル）が1人も存在しない場合だけ、この値から作成されます。
# 一度作成されると、この値を変更しても既存の管理者は上書きされません
# （パスワードの変更は今後のユーザー管理画面か、DB管理画面からのハッシュ差し替えで行ってください）。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# H2 Database Password
# 空のままだと、同じ端末のほかのユーザー・プロセスがパスワード無しで DB につながれる（#240）。
# 英数字だけの値にする（例: openssl rand -hex 24）。' や $ を含むと下の SQL や .env の読み込みで崩れる。
# 【既存の DB に設定する手順】DB は作ったときのパスワードを覚えているので、ここに書くだけでは
# 起動しなくなる。リポジトリの直下で、次の順に続けて行う（1 と 3 の間、稼働中のアプリは新しい
# DB 接続を作れないので間を空けない。録画中は 3 の再起動をしないこと）。
#   0. 控えを取る（サービスの稼働中でよい）:
#      H2_JAR="$(find ~/.gradle/caches -name 'h2-*.jar' ! -name '*sources*' | sort | tail -1)"
#      java -cp "$H2_JAR" org.h2.tools.Shell -url "jdbc:h2:file:./data/monitor;AUTO_SERVER=TRUE" \
#          -user sa -password "" -sql "BACKUP TO '$(pwd)/data/before-db-password.zip'"
#   1. PW="$(openssl rand -hex 24)"
#      java -cp "$H2_JAR" org.h2.tools.Shell -url "jdbc:h2:file:./data/monitor;AUTO_SERVER=TRUE" \
#          -user sa -password "" -sql "ALTER USER SA SET PASSWORD '$PW'"
#   2. echo "SPRING_DATASOURCE_PASSWORD=$PW" >> .env   （.env に既に空のキーがあれば、その行を書き換える）
#   3. bin/service.sh restart
# 【戻し方】起動しないとき（ログに Wrong user name or password）は、サービスを止めて空に戻す:
#      bin/service.sh stop
#      java -cp "$H2_JAR" org.h2.tools.Shell -url "jdbc:h2:file:./data/monitor" \
#          -user sa -password "$PW" -sql "ALTER USER SA SET PASSWORD ''"
#      .env の SPRING_DATASOURCE_PASSWORD の行を消してから bin/service.sh start
#   $PW（.env に書いた値）が分からなくなったら、止めたまま 0 の控えを戻す（控えの後の変更は失われる）:
#      mv data/monitor.mv.db data/monitor.mv.db.bad && (cd data && unzip -o before-db-password.zip)
#      .env の SPRING_DATASOURCE_PASSWORD の行を消してから bin/service.sh start
SPRING_DATASOURCE_PASSWORD=

# Twitch API Configuration
# Twitch のチャンネルを監視する場合のみ必要（未設定でも YouTube の監視には影響しない）
# https://dev.twitch.tv/console でアプリを登録すると発行されます
#   - アプリ登録にはアカウント側で二要素認証を有効にしておく必要があります
#   - クライアントタイプは「機密（Confidential）」を選ぶこと（公開だと Secret が発行されない）
#   - Client Secret は発行時に一度しか表示されません
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Monitor Interval (seconds)
# 何秒ごとにライブ配信を監視するか
# /live リダイレクト方式はクォータを消費しないため、短めの間隔でも問題ない（デフォルト: 120秒）
MONITOR_INTERVAL_SECONDS=120

# Recording Configuration
# 配信の自動録画に yt-dlp を使用する（チャンネルごとに有効/無効を切り替え可能）
# 保存先ディレクトリ（デフォルト: recordings）
MONITOR_RECORDING_DIRECTORY=recordings
# 録画する画質の上限（ピクセル）。0 は上限なし（配信で提供される最高画質・音質のまま録画する）で、
# 画質を落としたくないという方針からこれをデフォルトにしている。ディスク容量を優先したい場合のみ
# 正の値（例: 1080）を設定する。長時間配信では上限なしだと数十GB以上になりうるので注意（デフォルト: 0）
MONITOR_RECORDING_MAX_HEIGHT=0
# yt-dlp が YouTube の取得に使う JavaScript のランタイム（--js-runtimes に渡す RUNTIME[:PATH]）。
# yt-dlp が既定で探すのは deno だけで、無いと「No supported JavaScript runtime」と警告し、一部の形式が取れなくなりうる。
# deno を入れていない場合は既にある node などをパスごと指定する。空なら付けない（デフォルト: 空）
# 例: MONITOR_YTDLP_JS_RUNTIME=node:/home/<user>/.nvm/versions/node/<版>/bin/node
MONITOR_YTDLP_JS_RUNTIME=
