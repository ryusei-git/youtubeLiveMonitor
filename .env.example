# YouTube API Configuration
# Google Cloud Console から取得してください
# https://console.cloud.google.com/
YOUTUBE_API_KEY=your_youtube_api_key_here

# YouTube の検索（search.list）の 1 日の回数の上限（米国太平洋時間の 0 時＝日本の 16〜17 時に戻る）
# 既定値は、検索が 1 回 100 単位の旧方式でも 1 日 10,000 単位に収まる値
# （52 回 × 100 = 5,200 単位。動画の収集の 3,000 単位と合わせて 8,200 単位）。
# Cloud Console で検索が 1 回 1 単位の新方式と確かめられたら、増やしてよい。
# その場の検索の上限は DAILY_LIMIT - DISCOVERY_LIMIT（定期の新人発掘の枠を食わない）。
YOUTUBE_SEARCH_DAILY_LIMIT=52
YOUTUBE_SEARCH_DISCOVERY_LIMIT=12
YOUTUBE_SEARCH_PER_USER_LIMIT=10

# Discord Webhook Configuration
# Discord サーバー設定から Webhook URL を取得してください
DISCORD_WEBHOOK_URL=https://discordapp.com/api/webhooks/your_webhook_id_here

# Initial Admin Account
# 起動時に管理者（app_users テーブル）が1人も存在しない場合だけ、この値から作成されます。
# 一度作成されると、この値を変更しても既存の管理者は上書きされません（画面で変えたパスワードを再起動で消さないため）。
# パスワードの変更は管理画面の「利用者管理」で、忘れたときは CLI の set-password で行います（README「管理者のパスワードを忘れた」）。
# bin/api.sh はこの 2 つの値で管理者としてログインします。画面や CLI で管理者のパスワードを変えたら、ここも同じ値にしてください。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# H2 Database Password
# 空のままだと、同じ端末のほかのユーザー・プロセスがパスワード無しで DB につながれる（#240）。
# 英数字だけの値にする（例: openssl rand -hex 24）。' や $ を含むと下の SQL や .env の読み込みで崩れる。
# 【既存の DB に設定する手順】DB は作ったときのパスワードを覚えているので、ここに書くだけでは
# 起動しなくなる。リポジトリの直下で、次の順に続けて行う（1 と 3 の間、稼働中のアプリは新しい
# DB 接続を作れないので間を空けない。録画中は 3 の再起動をしないこと）。
# H2 はサービスと同じ版を run/ の jar から取り出して使う。-Dh2.bindAddress=127.0.0.1 は、サービスが
# 止まっているときに Shell が開く待ち受けをこの端末だけに限るため（#312 と同じ理由）。
#   0. 控えを取る（サービスの稼働中でよい）:
#      H2_JAR="$(mktemp)"; unzip -p run/youtubeLiveMonitor.jar 'BOOT-INF/lib/h2-*.jar' > "$H2_JAR"
#      java -Dh2.bindAddress=127.0.0.1 -cp "$H2_JAR" org.h2.tools.Shell -url "jdbc:h2:file:./data/monitor;AUTO_SERVER=TRUE" \
#          -user sa -password "" -sql "BACKUP TO '$(pwd)/data/before-db-password.zip'"
#   1. PW="$(openssl rand -hex 24)"
#      java -Dh2.bindAddress=127.0.0.1 -cp "$H2_JAR" org.h2.tools.Shell -url "jdbc:h2:file:./data/monitor;AUTO_SERVER=TRUE" \
#          -user sa -password "" -sql "ALTER USER SA SET PASSWORD '$PW'"
#   2. echo "SPRING_DATASOURCE_PASSWORD=$PW" >> .env   （.env に既に空のキーがあれば、その行を書き換える）
#   3. bin/service.sh restart
# 【戻し方】起動しないとき（ログに Wrong user name or password）は、サービスを止めて空に戻す:
#      bin/service.sh stop
#      java -cp "$H2_JAR" org.h2.tools.Shell -url "jdbc:h2:file:./data/monitor" \
#          -user sa -password "$PW" -sql "ALTER USER SA SET PASSWORD ''"
#      .env の SPRING_DATASOURCE_PASSWORD の行を消してから bin/service.sh start
#   $PW（.env に書いた値）が分からなくなったら、止めたまま 0 の控えを戻す（控えの後の変更は失われる）:
#      mv data/monitor.mv.db data/monitor.mv.db.bad && (cd data && unzip -o before-db-password.zip)
#      .env の SPRING_DATASOURCE_PASSWORD の行を消してから bin/service.sh start
SPRING_DATASOURCE_PASSWORD=

# Twitch API Configuration
# Twitch のチャンネルを監視する場合のみ必要（未設定でも YouTube の監視には影響しない）
# https://dev.twitch.tv/console でアプリを登録すると発行されます
#   - アプリ登録にはアカウント側で二要素認証を有効にしておく必要があります
#   - クライアントタイプは「機密（Confidential）」を選ぶこと（公開だと Secret が発行されない）
#   - Client Secret は発行時に一度しか表示されません
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Monitor Interval (seconds)
# 何秒ごとにライブ配信を監視するか
# /live リダイレクト方式はクォータを消費しないため、短めの間隔でも問題ない（デフォルト: 120秒）
MONITOR_INTERVAL_SECONDS=120

# Recording Configuration
# 配信の自動録画に yt-dlp を使用する（チャンネルごとに有効/無効を切り替え可能）
# 保存先ディレクトリ（デフォルト: recordings）
MONITOR_RECORDING_DIRECTORY=recordings
# 録画する画質の上限（ピクセル）。0 は上限なし（配信で提供される最高画質・音質のまま録画する）で、
# 画質を落としたくないという方針からこれをデフォルトにしている。ディスク容量を優先したい場合のみ
# 正の値（例: 1080）を設定する。長時間配信では上限なしだと数十GB以上になりうるので注意（デフォルト: 0）
MONITOR_RECORDING_MAX_HEIGHT=0
# Twitch の録画・ダウンロードだけに使う画質の上限（ピクセル）。Twitch はソース画質のまま配られ容量が大きいため、
# 既定で 720p に抑える。0 は上限なし。上限以下の形式が無い配信は最高画質で保存する（デフォルト: 720）
MONITOR_RECORDING_TWITCH_MAX_HEIGHT=720
# 保存先の空き容量（GB）がこれを下回っていると、新しい録画・動画のダウンロード・端末保存を始めない（デフォルト: 20）。
# 録画を見送ったときはログに WARN を出し、管理者の Discord（DISCORD_WEBHOOK_URL）へ知らせる。0 にすると確かめない。
# 「録画が始まらない」ときは、まずログの「空き容量がしきい値を下回っているため録画を始めません」を探す。
MONITOR_RECORDING_MIN_FREE_GB=20
# yt-dlp が YouTube の取得に使う JavaScript のランタイム（--js-runtimes に渡す RUNTIME[:PATH]）。
# yt-dlp が既定で探すのは deno だけで、無いと「No supported JavaScript runtime」と警告し、一部の形式が取れなくなりうる。
# deno を入れていない場合は既にある node などをパスごと指定する。空なら付けない（デフォルト: 空）
# 例: MONITOR_YTDLP_JS_RUNTIME=node:/home/<user>/.nvm/versions/node/<版>/bin/node
MONITOR_YTDLP_JS_RUNTIME=

# yt-dlp に --cookies で渡す、ログインした状態の Cookie ファイル（Netscape 形式）。
# ログインなしでは「Sign in to confirm you’re not a bot」で断られる配信を録画するために使う（作り方は README）。
# ファイルが無ければ付けない。録画専用のアカウントの Cookie を chmod 600 で置くこと（デフォルト: data/youtube-cookies.txt）
# MONITOR_YTDLP_COOKIES=data/youtube-cookies.txt

# Dashboard（端末の状態の画面 /system.html）
# 左のメニューに並べるほかのサービスの一覧（JSON。書き方は HubAppRegistry の JavaDoc）。
# ファイルが無ければ YouTube Live Monitor だけを並べる。変えたら再起動が要る（デフォルト: data/hub-apps.json）
# MONITOR_HUB_APPS_FILE=data/hub-apps.json

# Sound Detection（耳キスの検出）
# 録画が終わった録画に耳キスの検出を掛ける見回り（10 分ごと。録画中の録画がある間は休む）を動かすか。
# デフォルトは監視と同じ（通常の起動は true、bin/preview.sh の確認用の起動は false）。
# CPU を録画だけに使いたい端末では false にする（印を付ける・候補に答える操作は止めても使える）。
# MONITOR_SOUND_DETECTION_ENABLED=false

# New VTuber Discovery（新人発掘）
# 値に空白・|・* を含むときは、全体を二重引用符（"）で囲むこと。bin/api.sh・bin/backup.sh・bin/preview.sh が
# bash で .env を読み込むため、囲まないとそれらが壊れる（アプリは両端の二重引用符を外して読む）。
# 一重引用符（'）は使わない（アプリが値の一部として読んでしまう）。
# 定期の新人発掘を動かすか（デフォルト: 監視と同じ）
# MONITOR_DISCOVERY_ENABLED=false
# 発掘の時刻（Spring の cron 形式「秒 分 時 日 月 曜日」、日本時間。デフォルト: 03:00・11:00・19:00）。
# 1 回で検索語の数だけ検索を使うので、「検索語の数 × 1 日の回数」を YOUTUBE_SEARCH_DISCOVERY_LIMIT 以下にする。
# MONITOR_DISCOVERY_CRON="0 0 3,11,19 * * *"
# 30 日の決まり（候補を取り直す・判定されないまま 30 日たった候補を消す）の見回りの時刻（デフォルト: 04:30）
# MONITOR_DISCOVERY_SWEEP_CRON="0 30 4 * * *"
# 検索語（カンマ区切り。1 語で検索 1 回。| は YouTube の検索の「または」）
# MONITOR_DISCOVERY_TERMS="新人VTuber|新人Vtuber,初配信 VTuber,個人勢VTuber,デビュー配信 VTuber"
# VTuber らしさの語（カンマ区切り）。チャンネルの説明か、見つけた動画のタイトルに 1 つでも含まれれば候補にする
# MONITOR_DISCOVERY_WORDS="VTuber,Vtuber,バーチャル,Live2D,個人勢,初配信,新人"
# 候補にするのは、登録者数がこれ以下（登録者数を非公開にしているチャンネルも含む）で、
# 動画の数が MONITOR_DISCOVERY_MAX_VIDEOS 以下のチャンネル（デフォルト: 1000 と 10）
# MONITOR_DISCOVERY_MAX_SUBSCRIBERS=1000
# MONITOR_DISCOVERY_MAX_VIDEOS=10

# Network / Login
# 待ち受けるアドレス（デフォルト: 127.0.0.1）。外からは tailscale serve の HTTPS だけを通す前提。
# LAN から http://<端末のアドレス>:8080 を直接開くときだけ 0.0.0.0 にする（README「LAN から直接見たい場合の戻し方」）
# SERVER_ADDRESS=0.0.0.0
# セッションの Cookie に Secure を付けるか（デフォルト: true）。SERVER_ADDRESS=0.0.0.0 で LAN から http で開くときだけ false
# SESSION_COOKIE_SECURE=false
# 「ログインしたままにする」の Cookie に署名する鍵のファイル（デフォルト: data/remember-me.key。無ければ起動時に作る）。
# 消して再起動すると、全員の「ログインしたまま」が切れる
# MONITOR_REMEMBER_ME_KEY_FILE=data/remember-me.key
